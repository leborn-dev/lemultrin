{
  "name": "multrin",
  "version": "1.3.0",
  "description": "Tabbed window organizer",
  "keywords": [
    "organizer",
    "tabs",
    "material",
    "electron",
    "react",
    "mobx",
    "styled-components"
  ],
  "homepage": "https://github.com/sentialx/multrin#readme",
  "main": "build/main.bundle.js",
  "author": "Eryk Rakowski <sentialx@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentialx/multrin.git"
  },
  "bugs": {
    "url": "https://github.com/sentialx/multrin/issues"
  },
  "scripts": {
    "watch": "concurrently \"node scripts/dev-server.cjs\" \"cross-env ENV=dev webpack --config webpack.config.renderer.js --watch\" \"cross-env ENV=dev webpack --watch\"",
    "build": "concurrently \"webpack --config webpack.config.renderer.js\" \"webpack\"",
    "start": "cross-env ENV='dev' electron .",
    "compile-win32": "npm run build && electron-builder -w --publish never",
    "compile-darwin": "npm run build && electron-builder -m --publish never",
    "compile-linux": "npm run build && electron-builder -l --publish never",
    "compile": "node scripts/compile.js",
    "lint": "eslint \"src/**/*.ts*\" \"src/**/*.tsx*\"",
    "lint-fix": "npm run lint -- --fix",
    "rebuild": "electron-builder install-app-deps",
    "test:icon-palette": "node tests/icon-palette.cjs && node tests/palette-regression.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node tests/input-hook.cjs && node tests/icon-palette.cjs && node tests/palette-regression.cjs && node tests/window-security.cjs && node tests/dev-server.cjs && node tests/window-lifecycle.cjs && node tests/smoke-isolation.cjs && node tests/color-blend.cjs && node tests/png-inflate-budget.cjs",
    "package": "npm run build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "16.9.34",
    "@types/react-dom": "16.9.6",
    "@types/semver": "7.8.0",
    "@types/styled-components": "5.1.9",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "10.13.0",
    "gsap": "3.15.0",
    "html-webpack-plugin": "5.6.7",
    "mobx": "5.15.4",
    "mobx-react-lite": "^2.0.6",
    "prettier": "3.8.3",
    "react": "16.13.1",
    "react-dom": "16.13.1",
    "react-windows-controls": "1.1.1",
    "styled-components": "^5.1.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "webpack": "5.112.0",
    "webpack-cli": "6.0.1",
    "webpack-merge": "6.0.1"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "@vibrant/generator-default": "4.0.4",
    "@vibrant/quantizer-mmcq": "4.0.4",
    "electron-updater": "6.8.9",
    "extract-file-icon": "0.3.2",
    "node-window-manager": "2.2.4",
    "pngjs": "7.0.0",
    "uiohook-napi": "1.5.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
