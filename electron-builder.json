{
  "appId": "org.sential.multrin",
  "productName": "Multrin",
  "asar": true,
  "directories": {
    "output": "dist",
    "buildResources": "static/app-icons"
  },
  "files": [
    "build/**/*",
    "package.json"
  ],
  "publish": "github",
  "linux": {
    "category": "Network",
    "target": [
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "mac": {
    "category": "public.app-category.navigation",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ]
  }
}
